# ============================================
# Sentinel Unified Python Backend Environment
# ============================================
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# PostgreSQL (Async SQLAlchemy 2.0 + asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sentinel_db

# JWT & Token Encryption
JWT_SECRET=change_me_to_a_long_random_secret_in_production
TOKEN_ENCRYPTION_KEY=
RESEND_API_KEY=
EMAIL_FROM=Sentinel <noreply@sentinel.app>

# Google Gemini LLM
GEMINI_API_KEY=

# Redis / ARQ Background Scheduler
REDIS_URL=redis://localhost:6379

# Media Storage (Cloudinary for Images, MUX for Videos)
CLOUDINARY_CLOUD_NAME=sentinel_demo_cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=sentinel_cloudinary_secret_key
MUX_TOKEN_ID=sentinel_mux_token_id
MUX_TOKEN_SECRET=sentinel_mux_token_secret

# Social Login & Publishing OAuth Credentials (App-Level Keys)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/social/callback/linkedin

X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8000/api/v1/social/callback/x

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/v1/social/callback/instagram
