# ============================================
# Dispatch Unified Python Backend Environment
# ============================================
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# PostgreSQL (Async SQLAlchemy 2.0 + asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dispatch_db

# JWT & Token Encryption
JWT_SECRET=change_me_to_a_long_random_secret_in_production
TOKEN_ENCRYPTION_KEY=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
RESEND_API_KEY=
EMAIL_FROM=Dispatch <noreply@dispatch.io>

# Google Gemini LLM
GEMINI_API_KEY=

# Redis / ARQ Background Scheduler
REDIS_URL=redis://localhost:6379

# Primary Media Engine (Cloudflare R2 - S3-compatible, zero egress fees)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=dispatch-media
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev

# Fallback Media Engines (MUX for Videos, Cloudinary for Images)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
MUX_TOKEN_ID=your_mux_token_id
MUX_TOKEN_SECRET=your_mux_token_secret

# Social Login & Publishing OAuth Credentials (App-Level Keys)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/social/callback/linkedin

X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8000/api/v1/social/callback/x

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/v1/social/callback/instagram
